{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidoc.app/schemas/team-adapter/1/scheme.schema.json",
  "type": "object",
  "properties": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "department": {
          "type": "string",
          "maxLength": 500
        },
        "purpose": {
          "type": "string",
          "maxLength": 500
        },
        "storage_location": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "contact": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tax_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "short_name": {
            "type": "string",
            "maxLength": 64
          },
          "color": {
            "enum": [
              "neutral",
              "blue",
              "green",
              "amber",
              "purple",
              "red",
              "teal"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "tax_id",
          "short_name",
          "color"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {},
          "fixed": {},
          "editable": {
            "type": "boolean"
          },
          "presentation": {
            "enum": [
              "visible",
              "advanced",
              "hidden"
            ]
          },
          "x_metadata": {
            "type": "object"
          }
        },
        "required": [
          "editable",
          "presentation"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "default"
            ]
          },
          {
            "required": [
              "fixed"
            ]
          }
        ]
      }
    },
    "import_defaults": {
      "type": "object",
      "properties": {
        "entry.default_title_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "entry.default_paid_to_invoice": {
          "type": "boolean"
        },
        "entry.suggested_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 30
        }
      },
      "additionalProperties": false
    },
    "default_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "maxItems": 30
    },
    "x_metadata": {
      "type": "object"
    }
  },
  "required": [
    "organization",
    "titles",
    "settings"
  ],
  "additionalProperties": false
}
