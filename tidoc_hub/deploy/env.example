# Copy to /opt/bitfsae-tidoc-hub/.env and chmod 600 /opt/bitfsae-tidoc-hub/.env
# Never commit real SecretId / SecretKey to Git.

TIDOC_HUB_HOST=127.0.0.1
TIDOC_HUB_PORT=8767
TIDOC_HUB_PREFIX=/tidoc-hub
TIDOC_HUB_DATA_DIR=/opt/bitfsae-tidoc-hub/data
TIDOC_HUB_STORAGE=cos
TIDOC_HUB_TRUST_PROXY=1

COS_BUCKET=bitfsae-tidoc-1416420925
COS_REGION=ap-beijing
COS_SECRET_ID=REPLACE_WITH_TIDOC_HUB_COS_SECRET_ID
COS_SECRET_KEY=REPLACE_WITH_TIDOC_HUB_COS_SECRET_KEY
